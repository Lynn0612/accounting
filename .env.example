# Supabase Configuration (Required)
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application URL (Optional - defaults to window.location.origin if not set)
# For production, set this to your Vercel deployment URL
# Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# LINE Login Configuration (Optional - only needed if using LINE login)
# Get these from LINE Developers Console
NEXT_PUBLIC_LINE_CHANNEL_ID=your-line-channel-id

# Debug Login Credentials (Optional - only for development)
# Remove these in production
NEXT_PUBLIC_DEBUG_USER2_EMAIL=
NEXT_PUBLIC_DEBUG_USER2_PASSWORD=
